# ─────────────────────────────────────────────────────────────
# Cloud Functions environment configuration
#
# Copy to `.env` (or set these in your deploy environment) and
# deploy with `firebase deploy --only functions`. These values are
# read by the functions at runtime; changing them requires a redeploy.
# ─────────────────────────────────────────────────────────────

# Super-admin bootstrap email for the platform-access callables.
# The account that can grant/revoke platform access. Leave unset to
# have no bootstrap super-admin.
# SUPER_ADMIN_EMAIL=you@example.com

# CDN (shared) cache duration, in seconds, for GET /api/v1/version.
# This is your change-propagation latency: a config change reaches a
# client no later than the next time it re-polls /version past this
# window. Larger = fewer getVersion invocations (cheaper) but slower
# propagation. Default: 300 (5 minutes). Invalid/<=0 values fall back
# to the default. Changing this requires redeploying the functions.
VERSION_CACHE_SECONDS=300
