{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "dist",
    "build",
    "coverage",
    "node_modules",
    "pnpm-lock.yaml",
    "*.min.js",
    "*.min.css"
  ]
}
