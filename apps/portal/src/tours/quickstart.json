[
  {
    "id": "create-project",
    "name": "Create Your First Project",
    "trigger": {
      "type": "context",
      "condition": { "key": "hasProject", "op": "equals", "value": false }
    },
    "steps": [
      {
        "id": "welcome",
        "type": "modal",
        "title": "👋 Welcome to Config Portal",
        "description": "Let's get you set up. First, we'll create a project to group your configs.",
        "actions": [
          { "label": "Create project" },
          { "label": "Skip", "dismiss": true }
        ]
      },
      {
        "id": "click-project-switcher",
        "type": "spotlight",
        "target": "[data-tour='project-switcher']",
        "title": "Create a project",
        "description": "Click here to create your first project. Projects group configs by app or service.",
        "position": "bottom",
        "waitFor": {
          "type": "click",
          "target": "[data-tour='project-switcher']"
        }
      }
    ]
  },
  {
    "id": "create-environment",
    "name": "Create an Environment",
    "trigger": {
      "type": "context",
      "condition": { "key": "needsEnvironment", "op": "exists" }
    },
    "steps": [
      {
        "id": "intro",
        "type": "modal",
        "title": "🌍 Set up an environment",
        "description": "Environments separate your dev, staging, and production configs. Let's create one.",
        "actions": [
          { "label": "Go to Settings" },
          { "label": "Later", "dismiss": true }
        ]
      },
      {
        "id": "nav-to-settings",
        "type": "tooltip",
        "target": "[data-tour='nav-settings']",
        "title": "Go to Settings",
        "description": "Click Settings to manage environments.",
        "position": "bottom",
        "waitFor": { "type": "route-change", "path": "/settings" }
      }
    ]
  },
  {
    "id": "create-first-config",
    "name": "Create Your First Config",
    "trigger": {
      "type": "context",
      "condition": { "key": "needsConfig", "op": "exists" }
    },
    "steps": [
      {
        "id": "intro",
        "type": "modal",
        "title": "🚀 Create your first config",
        "description": "You have a project and environment ready. Let's add your first feature flag.",
        "actions": [
          { "label": "Let's go" },
          { "label": "Skip", "dismiss": true }
        ]
      },
      {
        "id": "nav-to-configs",
        "type": "tooltip",
        "target": "[data-tour='nav-configs']",
        "title": "Go to Configs",
        "description": "Navigate to the Configs tab.",
        "position": "bottom",
        "waitFor": { "type": "route-change", "path": "/configs" }
      },
      {
        "id": "click-add",
        "type": "spotlight",
        "target": "[data-tour='add-config-btn']",
        "title": "Add a config",
        "description": "Click here to create a feature flag or config value.",
        "position": "bottom",
        "page": "/configs",
        "waitFor": {
          "type": "element-visible",
          "selector": "[data-tour='config-form-modal']"
        }
      },
      {
        "id": "done",
        "type": "modal",
        "title": "🎉 You're all set!",
        "description": "Your config is ready. Grab an API key from the API Keys tab to integrate the SDK.",
        "actions": [{ "label": "Done", "dismiss": true }]
      }
    ]
  }
]
