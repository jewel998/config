---
import "../styles/story.css";
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@jewel998/config — Feature Flags Without The Bill</title>
  <meta name="description" content="Free, self-hosted feature flags with segments, targeting, rollouts, and audit trails. Replace LaunchDarkly at $0/month." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    background: #050508;
    color: #fff;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }

  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
  @media(min-width: 768px) { .wrap { padding: 0 40px; } }
  @media(min-width: 1024px) { .wrap { padding: 0 56px; } }

  .sec { position: relative; padding: 100px 0; overflow: hidden; }
  .sec-alt { background: #08080c; }
  .sec-hdr { text-align: center; margin-bottom: 56px; }
  .sec-hdr h2 { font-size: clamp(28px, 4.2vw, 46px); font-weight: 700; letter-spacing: -.04em; line-height: 1.12; margin-bottom: 14px; background: linear-gradient(180deg, #fff 30%, rgba(255,255,255,.6)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .sec-hdr p { font-size: clamp(14px, 1.5vw, 16px); color: #9ca3af; max-width: 500px; margin: 0 auto; line-height: 1.65; letter-spacing: -.01em; }

  .glass-card {
    background: rgba(255,255,255,.025);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.07);
    box-shadow: 0 8px 32px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.04);
    position: relative;
    overflow: hidden;
  }
  .glass-card::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.1) 50%, transparent);
    pointer-events: none;
  }

  /* Shared utilities */
  .sec-eyebrow { display: inline-block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #60a5fa; margin-bottom: 12px; }
  .glow-orb { position: absolute; width: 400px; height: 400px; border-radius: 50%; filter: blur(120px); opacity: .1; pointer-events: none; }
  .glow-orb-purple { background: #7c3aed; bottom: -100px; left: -100px; }
  .glow-orb-blue { background: #3b82f6; top: -80px; right: -120px; }

  /* Mobile responsive base */
  @media (max-width: 767px) {
    .sec { padding: 64px 0; }
    .sec-hdr { margin-bottom: 36px; }
    .sec-hdr h2 { font-size: 26px; }
    .sec-hdr p { font-size: 14px; }
    .glow-orb { width: 250px; height: 250px; }
  }
</style>
