---
import CopyCommand from "./CopyCommand";
---
<section class="sec" id="resources">
  <div class="glow-orb glow-orb-blue"></div>
  <div class="wrap">
    <header class="sec-hdr">
      <span class="sec-eyebrow">Self-hosted</span>
      <h2>Deploy to your own Firebase in minutes</h2>
      <p>You own the infrastructure. Your data stays on your project. We provide the code — you deploy it.</p>
    </header>

    <!-- Deploy steps -->
    <div class="deploy-steps">
      <div class="deploy-step glass-card">
        <div class="deploy-num">1</div>
        <div class="deploy-body">
          <h3>Clone the repository</h3>
          <CopyCommand client:visible command="git clone https://github.com/jewel998/config && cd config" />
          <p>The full source — portal, SDK, cloud functions, docs. All yours.</p>
        </div>
      </div>
      <div class="deploy-step glass-card">
        <div class="deploy-num">2</div>
        <div class="deploy-body">
          <h3>Connect your Firebase project</h3>
          <CopyCommand client:visible command="firebase use --add your-project-id" />
          <p>Point it at your own Firebase. Firestore, Hosting, Cloud Functions — all on your account.</p>
        </div>
      </div>
      <div class="deploy-step glass-card">
        <div class="deploy-num">3</div>
        <div class="deploy-body">
          <h3>Deploy everything</h3>
          <CopyCommand client:visible command="pnpm install && firebase deploy" />
          <p>Portal, API, and hosting — deployed to your infrastructure in one command.</p>
        </div>
      </div>
      <div class="deploy-step glass-card">
        <div class="deploy-num">4</div>
        <div class="deploy-body">
          <h3>Install the SDK in your app</h3>
          <CopyCommand client:visible command="npm install @jewel998/config" />
          <p>Point the SDK at your deployed API. Generate an API key from your portal and start fetching flags.</p>
        </div>
      </div>
    </div>

    <!-- Upgrade note -->
    <div class="deploy-note glass-card">
      <div class="deploy-note-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16v-4"/><path d="M12 8h.01"/><circle cx="12" cy="12" r="10"/></svg>
      </div>
      <div>
        <strong>Upgrades & migrations</strong>
        <p>When new versions are released, pull the latest changes and redeploy. We provide migration guides for breaking changes. Your data stays in your Firestore — always under your control.</p>
      </div>
    </div>

    <!-- Doc links -->
    <div class="res-links">
      <a href="/config/guide/self-hosting.html" class="res-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        <span>Self-Hosting Guide</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/config/api/" class="res-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <span>SDK & API Reference</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="https://github.com/jewel998/config" class="res-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        <span>GitHub Repository</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* Deploy steps */
  .deploy-steps { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto; }
  .deploy-step { display: flex; align-items: flex-start; gap: 16px; padding: 18px 22px; border-radius: 14px; }
  .deploy-num { width: 30px; height: 30px; border-radius: 8px; background: rgba(99,102,241,.1); border: 1px solid rgba(99,102,241,.2); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #a5b4fc; flex-shrink: 0; }
  .deploy-body { flex: 1; }
  .deploy-body h3 { font-size: 14px; font-weight: 600; margin-bottom: 4px; letter-spacing: -.01em; }
  .deploy-body p { font-size: 12.5px; color: rgba(255,255,255,.4); line-height: 1.5; margin-top: 4px; }
  .deploy-cmd { display: block; font-family: "SF Mono","Fira Code",monospace; font-size: 11.5px; color: rgba(255,255,255,.65); background: rgba(255,255,255,.03); padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,.05); margin-top: 4px; overflow-x: auto; white-space: nowrap; }

  /* Upgrade note */
  .deploy-note { display: flex; align-items: flex-start; gap: 14px; padding: 18px 22px; border-radius: 14px; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto; }
  .deploy-note-icon { color: rgba(255,255,255,.4); flex-shrink: 0; margin-top: 2px; }
  .deploy-note strong { font-size: 13px; font-weight: 600; display: block; margin-bottom: 4px; }
  .deploy-note p { font-size: 12.5px; color: rgba(255,255,255,.4); line-height: 1.55; }

  /* Doc links */
  .res-links { display: flex; flex-direction: column; gap: 6px; max-width: 600px; margin: 0 auto; }
  .res-link { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 10px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,.6); transition: background .2s, color .2s, transform .2s; }
  .res-link:hover { background: rgba(255,255,255,.03); color: #fff; transform: translateX(4px); }
  .res-link svg:last-child { margin-left: auto; opacity: .3; transition: opacity .2s, transform .2s; }
  .res-link:hover svg:last-child { opacity: .7; transform: translateX(2px); }

  @media (max-width: 767px) {
    .deploy-steps { gap: 10px; }
    .deploy-step { padding: 14px 16px; gap: 12px; flex-direction: column; align-items: flex-start; }
    .deploy-body h3 { font-size: 13px; }
    .deploy-note { flex-direction: column; gap: 10px; padding: 14px 16px; }
    .res-link { padding: 10px 12px; font-size: 12px; }
  }
</style>
