  .ft-lic { font-size: 11px !important; color: #4b5563 !important; }
  .ft-col { display: flex; flex-direction: column; gap: 9px; }
  .ft-col h4 { font-size: 11px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 2px; }
  .ft-col a { font-size: 13px; color: #9ca3af; transition: color .15s; }
  .ft-col a:hover { color: #fff; }

  @media (max-width: 767px) {
    .ft { padding: 40px 0 28px; }
    .ft-grid { gap: 28px; grid-template-columns: 1fr 1fr; }
  }
</style>
