{
  "name": "@jewel998/config",
  "version": "0.2.2",
  "private": false,
  "description": "Free, self-hosted feature flags and remote configuration SDK",
  "keywords": [
    "a-b-testing",
    "configuration",
    "feature-flags",
    "feature-management",
    "feature-toggles",
    "firebase",
    "free",
    "launchdarkly-alternative",
    "open-source",
    "percentage-rollout",
    "remote-config",
    "rollout",
    "sdk",
    "segments",
    "self-hosted",
    "server-side-evaluation",
    "targeting"
  ],
  "homepage": "https://github.com/jewel998/config#readme",
  "bugs": {
    "url": "https://github.com/jewel998/config/issues"
  },
  "license": "Elastic-2.0",
  "author": "Jyotirmoy Barman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jewel998/config.git",
    "directory": "packages/config"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./storage": {
      "types": "./dist/cache/memoryStorage.d.ts",
      "import": "./dist/cache/memoryStorage.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js"
    },
    "./targeting": {
      "types": "./dist/plugins/targeting/index.d.ts",
      "import": "./dist/plugins/targeting/index.js"
    },
    "./rollout": {
      "types": "./dist/plugins/rollout/index.d.ts",
      "import": "./dist/plugins/rollout/index.js"
    },
    "./schedule": {
      "types": "./dist/plugins/schedule/index.d.ts",
      "import": "./dist/plugins/schedule/index.js"
    },
    "./prerequisites": {
      "types": "./dist/plugins/prerequisites/index.d.ts",
      "import": "./dist/plugins/prerequisites/index.js"
    },
    "./lifecycle": {
      "types": "./dist/plugins/lifecycle/index.d.ts",
      "import": "./dist/plugins/lifecycle/index.js"
    },
    "./overrides": {
      "types": "./dist/plugins/overrides/index.d.ts",
      "import": "./dist/plugins/overrides/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
