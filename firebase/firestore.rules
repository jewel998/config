rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      // Read: any authenticated project member OR invited user (email-prefixed entry)
      allow read: if request.auth != null
        && !('deletedAt' in resource.data)
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.authorizedUsers
            || ('email:' + request.auth.token.email) in resource.data.authorizedUsers);
      allow create: if request.auth != null;
      // Update: admin OR self-claiming an invite (replacing email entry with uid)
      allow update: if request.auth != null
        && (hasRole(projectId, 'admin') || isSelfClaim(projectId));
      allow delete: if request.auth != null && hasRole(projectId, 'admin');

      // Environments
      match /environments/{environmentId} {
        allow read: if request.auth != null && isProjectMember(projectId);
        allow create, update, delete: if request.auth != null
          && (hasRole(projectId, 'admin')
              || (hasRole(projectId, 'editor')
                  && !resource.data.isProduction));
      }

      // Configs
      match /environments/{environmentId}/configs/{configKey} {
        allow read: if request.auth != null && isProjectMember(projectId);
        allow create, update: if request.auth != null
          && (hasRole(projectId, 'admin')
              || (hasRole(projectId, 'editor')
                  && !getEnvironment(projectId, environmentId).data.isProduction));
        allow delete: if request.auth != null && hasRole(projectId, 'admin');
      }

      // Client IDs
      match /environments/{environmentId}/clientIds/{clientIdToken} {
        allow read: if request.auth != null && isProjectMember(projectId);
        allow create, update, delete: if request.auth != null
          && hasRole(projectId, 'admin');
      }

      // Segments
      match /segments/{segmentId} {
        allow read: if request.auth != null && isProjectMember(projectId);
        allow create, update, delete: if request.auth != null
          && (hasRole(projectId, 'admin')
              || hasRole(projectId, 'editor'));
      }

      // Audit log — append-only, no modify/delete
      match /audit_log/{entryId} {
        allow read: if request.auth != null && isProjectMember(projectId);
        allow create: if request.auth != null && isProjectMember(projectId);
        allow update, delete: if false;
      }
    }

    // User profiles — email immutable after creation
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Pending invites — admin create/delete, email-matching read, invited user can delete own
    match /pendingInvites/{inviteId} {
      allow read: if request.auth != null
        && resource.data.email == request.auth.token.email;
      allow create: if request.auth != null
        && hasRole(request.resource.data.projectId, 'admin');
      allow delete: if request.auth != null
        && (hasRole(resource.data.projectId, 'admin')
            || resource.data.email == request.auth.token.email);
      allow update: if false;
    }

    // Rate limits
    match /rateLimits/{clientId} {
      allow read, write: if false;
    }

    // Allowed users — gate for portal login
    match /allowedUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Helper functions
    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return !('deletedAt' in project.data)
        && (project.data.ownerId == request.auth.uid
            || request.auth.uid in project.data.authorizedUsers
            || ('email:' + request.auth.token.email) in project.data.authorizedUsers);
    }

    function hasRole(projectId, role) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      let uid = request.auth.uid;
      return project.data.ownerId == uid
        || (
          'roles' in project.data
          && uid in project.data.roles
          && (
            (role == 'viewer')
            || (role == 'editor' && (project.data.roles[uid] == 'editor' || project.data.roles[uid] == 'admin'))
            || (role == 'admin' && project.data.roles[uid] == 'admin')
          )
        );
    }

    function isSelfClaim(projectId) {
      // Allow a user to claim their invite: they must have an email-prefixed entry
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      let emailKey = 'email:' + request.auth.token.email;
      return emailKey in project.data.authorizedUsers
        && request.auth.uid in request.resource.data.authorizedUsers;
    }

    function getEnvironment(projectId, envId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/environments/$(envId));
    }
  }
}
