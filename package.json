{
  "name": "config-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, standards-first configuration platform.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @jewel998/config run build",
    "build:docs": "pnpm --filter @jewel998/config-docs run build",
    "build:portal": "pnpm --filter @jewel998/config-portal run build",
    "test": "pnpm --filter @jewel998/config run test",
    "lint": "oxlint packages/config/src apps/portal/src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^0.16.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,tsx}": [
      "oxlint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "postcss": "^8.4.49",
      "rollup": "^4.48.0",
      "vite": "^8.1.5"
    }
  }
}
