{
  "name": "config-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "A lightweight, standards-first configuration platform.",
  "license": "ISC",
  "scripts": {
    "build": "pnpm --filter @jewel998/config run build",
    "build:functions": "pnpm --filter @jewel998/config-functions run build",
    "build:docs": "pnpm --filter @jewel998/config-docs run build",
    "build:portal": "pnpm --filter @jewel998/config-portal run build",
    "test": "pnpm --filter @jewel998/config run test",
    "lint": "oxlint packages/config/src apps/portal/src functions/src && eslint --no-warn-ignored",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html}\"",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^9.27.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxlint": "^0.16.0",
    "prettier": "^3.5.2",
    "typescript-eslint": "^8.32.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "postcss": "^8.4.49",
      "rollup": "^4.48.0",
      "vite": "^8.1.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,html}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "oxlint",
      "eslint --no-warn-ignored"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
